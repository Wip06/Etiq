{
  "expo": {
    "name": "Etiq",
    "slug": "etiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D9C08A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1F1A",
          "image": "./assets/splash-tiko.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Etiq utilise l'appareil photo pour scanner le code-barres et l'étiquette de composition de vos vêtements.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "scheme": "etiq",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0F1F1A"
  }
}
